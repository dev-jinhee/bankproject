<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.or.oti.bankproject.dao.AccountDAO">

	<!--계좌 등록-->
	<insert id="addAccount">
		insert into account(
		accountNo,
		name,
		balance
		) values(
		#{accountNo},
		#{name},
		0
		)
	</insert>
	<!--계좌 단건 조회-->
	<select id="getAccount" resultType="kr.or.oti.bankproject.domain.Account">
		select *
		from account
		where accountNo = #{accountNo}
	</select>
	<!--소유자명으로 계좌 목록 조회-->
	<select id="findAccounts" resultType="kr.or.oti.bankproject.domain.Account">
		select *
		from account
		where name = #{name}
	</select>
	<!--전체 계좌 목록 조회-->
	<select id="getAccounts" resultType="kr.or.oti.bankproject.domain.Account">
		select *
		from account
	</select>
	<!--총 계좌 수 조회-->
	<select id="getTotalAccount" resultType="int">
		select count(*)
		from account
	</select>
	<!--잔액 업데이트-->
	<update id="updateBalance">
		update account
		set balance = #{balance}
		where accountNo = #{accountNo}
	</update>
	<!--거래 내역 저장-->
	<insert id="insertTransaction">
		INSERT INTO transactions
		(accountNo, amount, kind, balance, transactionDate, transactionTime)
		VALUES
		(#{accountNo},
		#{transaction.amount},
		#{transaction.kind},
		#{transaction.balance},
		#{transaction.transactionDate},
		#{transaction.transactionTime})
	</insert>
	<!--특정 계좌의 거래 내역 조회-->
	<select id="getTransactions" resultType="kr.or.oti.bankproject.domain.Transaction">
		select *
		from transactions
		where accountNo = #{accountNo}
	</select>

</mapper>